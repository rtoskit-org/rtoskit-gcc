#!/usr/bin/env bash
#
# Copyright (C) 2026 Red Rocket Computing, LLC
#
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at http://mozilla.org/MPL/2.0/.
#
# validate-toolchain
#
# Smoke test of an installed toolchain: the multilibs, the core-to-multilib selection, the default TLS
# model, gdb with Python, and that a threaded program using printf, sinf and thread_local links with every
# multilib (release and speed builds) and runs under qemu-arm through the Linux test port, and a C++ program
# (constructors, exceptions, RTTI, thread_local destructors) does the same; so do the hosted libstdc++, its
# -fno-exceptions and -fno-rtti modes, std::stacktrace, the C++ threading classes (std::thread, std::mutex, ...) and the timing of sleep_for,
# wait_for and try_lock_for on steady_clock and system_clock, and that libstdc++ was configured with every feature
# <rtoskit-libc.h> names.
#
# Usage: validate-toolchain <toolchain directory>      (the unpacked gcc-arm-none-eabi-<version>)
#
# Created on: Oct 29, 2026
#     Author: Stephen Street (stephen@redrocketcomputing.com)
#

set -u

if [[ -z "${1:-}" || ! -x "$1/bin/arm-none-eabi-gcc" ]]; then
	echo "usage: $0 <toolchain directory>" >&2
	exit 2
fi

PROJECT_ROOT=${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}
T=$(realpath "$1")
GCC=$T/bin/arm-none-eabi-gcc
OBJDUMP=$T/bin/arm-none-eabi-objdump
MAP=${PROJECT_ROOT}/compilers/arm-none-eabi/rtoskit/multilib.map
work=$(mktemp -d)
trap 'rm -rf "${work}"' EXIT

failures=0
pass() { echo "PASS $*"; }
fail() { echo "FAIL $*"; failures=$((failures + 1)); }
check() { # check <name> <expected> <actual>
	if [[ "$2" == "$3" ]]; then pass "$1"; else fail "$1: expected '$2', got '$3'"; fi
}

echo "toolchain: $("${GCC}" --version | head -1)"

# The multilibs GCC builds are exactly the ones in the map
expected=$(sed -e 's/#.*//' "${MAP}" | awk 'NF { print $1 }' | sort | tr '\n' ' ')
actual=$("${GCC}" -print-multi-lib | cut -d';' -f1 | sort | tr '\n' ' ')
check "multilib list" "${expected}" "${actual}"

# Which multilib a core selects
select_check() { # select_check <options> <expected multilib>
	# shellcheck disable=SC2086
	check "select [$1]" "$2" "$("${GCC}" $1 -print-multi-directory)"
}
select_check "-mcpu=cortex-m0plus" thumb/v6-m/nofp
select_check "-mcpu=cortex-m23" thumb/v6-m/nofp
select_check "-mcpu=cortex-m3" thumb/v7-m/nofp
select_check "-mcpu=cortex-m4" thumb/v7e-m/nofp
select_check "-mcpu=cortex-m4 -mfloat-abi=softfp" thumb/v7e-m/nofp
select_check "-mcpu=cortex-m4 -mfloat-abi=hard" thumb/v7e-m+fp/hard
select_check "-mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard" thumb/v7e-m+dp/hard
select_check "-mcpu=cortex-m33" thumb/v8-m.main/nofp
select_check "-mcpu=cortex-m33 -mfloat-abi=hard" thumb/v8-m.main+fp/hard
select_check "-mcpu=cortex-m55 -mfloat-abi=hard" thumb/v8-m.main+fp/hard

# thread_local defaults to local-exec, and an explicit -ftls-model still wins
printf 'extern _Thread_local int x;\nint f(void) { return x; }\n' > "${work}/tls.c"
tls_relocs() { # tls_relocs [options]
	# shellcheck disable=SC2086
	"${GCC}" -mcpu=cortex-m4 -O2 $1 -c "${work}/tls.c" -o "${work}/tls.o" &&
		"${OBJDUMP}" -r "${work}/tls.o" | grep -oE 'R_ARM_TLS_[A-Z0-9_]+' | sort -u | tr '\n' ' '
}
check "TLS default" "R_ARM_TLS_LE32 " "$(tls_relocs "")"
check "TLS override" "R_ARM_TLS_IE32 " "$(tls_relocs "-ftls-model=initial-exec")"

# gdb with Python
check "gdb python" "ok" "$("$T/bin/arm-none-eabi-gdb" -batch -ex 'python print("ok")' 2>&1 | tail -1)"

# A threaded program: link with every multilib, release and speed, then run it under qemu
cat > "${work}/thr.c" <<'EOF'
#include <stdio.h>
#include <threads.h>
#include <math.h>
thread_local int tls = 1;
static int worker(void *arg)
{
	tls += (int)(long)arg;
	printf("thread tls=%d sinf=%.6f\n", tls, (double)sinf(1.0f));
	return tls;
}
int main(void)
{
	thrd_t t;
	int res;
	thrd_create(&t, worker, (void *)41);
	thrd_join(t, &res);
	printf("main tls=%d joined=%d\n", tls, res);
	return 0;
}
EOF
want="thread tls=42 sinf=0.841471 main tls=1 joined=42"
have_qemu=y
command -v qemu-arm > /dev/null || { have_qemu=n; echo "note: qemu-arm not found, programs are linked but not run"; }

for options in "-mcpu=cortex-m0plus" "-mcpu=cortex-m3" "-mcpu=cortex-m4" "-mcpu=cortex-m4 -mfloat-abi=hard" \
	"-mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard" "-mcpu=cortex-m33" "-mcpu=cortex-m33 -mfloat-abi=hard"; do
	for speed in "" "--speed"; do
		name="threads [${options} ${speed}]"
		# shellcheck disable=SC2086
		if ! "${GCC}" ${options} ${speed} --specs=rtoskit-linux.specs -Os "${work}/thr.c" -o "${work}/thr.elf" 2> "${work}/err.txt"; then
			fail "${name}: $(head -1 "${work}/err.txt")"
			continue
		fi
		if [[ ${have_qemu} == y ]]; then
			got=$(timeout 30 qemu-arm -cpu max "${work}/thr.elf" 2>&1 | tr '\n' ' ' | sed 's/ $//')
			check "${name}" "${want}" "${got}"
		else
			pass "${name} (linked)"
		fi
	done
done

# C++ (the freestanding libstdc++ only): static constructors and destructors in order, new/delete, RTTI, an
# exception, std::atomic, and thread_local objects with destructors, in the main thread and in a thread. The
# destructors run through rtoskit-libc's __cxa_atexit and __cxa_thread_atexit, not libsupc++'s own.
cat > "${work}/cxx.cc" <<'EOF'
#include <stdio.h>
#include <threads.h>
#include <atomic>
#include <array>
struct S {
	const char *n;
	S(const char *n) : n(n) { printf("ctor %s\n", n); }
	~S() { printf("dtor %s\n", n); }
};
static S a("a");
struct B { virtual ~B() {} virtual int f() const { return 1; } };
struct D : B { int f() const override { return 2; } };
static thread_local S tl("tl-main");
static int worker(void *) { static thread_local S t("tl-thread"); return t.n[0] == 't' ? 0 : 1; }
struct Ex { int v; };
static int thrower(int x) { if (x) throw Ex{x}; return 0; }
static std::atomic<int> counter{0};
int main()
{
	S b("b");
	B *p = new D;
	printf("f=%d rtti=%d\n", p->f(), dynamic_cast<D *>(p) != nullptr);
	delete p;
	try { thrower(42); } catch (const Ex &e) { printf("caught %d\n", e.v); }
	std::array<int, 3> r{1, 2, 3};
	counter += r[1];
	thrd_t t;
	int res = -1;
	thrd_create(&t, worker, nullptr);
	thrd_join(t, &res);
	printf("worker=%d counter=%d tl=%s\n", res, counter.load(), tl.n);
	return 0;
}
EOF
cxx_want="ctor a ctor b f=2 rtti=1 caught 42 ctor tl-thread dtor tl-thread ctor tl-main worker=0 counter=2 tl=tl-main dtor b dtor tl-main dtor a"
GXX="${GCC%gcc}g++"
for options in "-mcpu=cortex-m0plus" "-mcpu=cortex-m3" "-mcpu=cortex-m4" "-mcpu=cortex-m4 -mfloat-abi=hard" \
	"-mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard" "-mcpu=cortex-m33" "-mcpu=cortex-m33 -mfloat-abi=hard"; do
	for speed in "" "--speed"; do
		name="c++ [${options} ${speed}]"
		# shellcheck disable=SC2086
		if ! "${GXX}" ${options} ${speed} --specs=rtoskit-linux.specs -Os -Wall -Werror "${work}/cxx.cc" -o "${work}/cxx.elf" 2> "${work}/err.txt"; then
			fail "${name}: $(head -1 "${work}/err.txt")"
			continue
		fi
		if [[ ${have_qemu} == y ]]; then
			got=$(timeout 30 qemu-arm -cpu max "${work}/cxx.elf" 2>&1 | tr '\n' ' ' | sed 's/ $//')
			check "${name}" "${cxx_want}" "${got}"
		else
			pass "${name} (linked)"
		fi
	done
done

# The hosted libstdc++: containers, strings, algorithms and ranges, <functional>, <optional> and <variant>, <regex>,
# <random>, <chrono>, string streams, exceptions through the library, and iostream and std::println on the C library's
# stdio.
cat > "${work}/hosted.cc" <<'EOF'
#include <algorithm>
#include <chrono>
#include <cstdio>
#include <functional>
#include <iostream>
#include <numeric>
#include <optional>
#include <print>
#include <random>
#include <ranges>
#include <regex>
#include <sstream>
#include <stdexcept>
#include <string>
#include <unordered_map>
#include <variant>
#include <vector>
static int failed;
#define CHECK(c) do { if (!(c)) { std::printf("FAIL %s\n", #c); failed++; } } while (0)
int main()
{
	std::vector<int> v(20);
	std::iota(v.begin(), v.end(), 1);
	std::ranges::reverse(v);
	CHECK(v.front() == 20);
	int sum = 0;
	for (int x : v | std::views::filter([](int x) { return x % 2 == 0; }) | std::views::transform([](int x) { return x * x; }))
		sum += x;
	CHECK(sum == 1540);
	std::unordered_map<std::string, int> m{{"one", 1}, {"two", 2}};
	CHECK(m["two"] == 2);
	std::function<int(int)> f = [&](int x) { return x + m["one"]; };
	CHECK(f(41) == 42);
	std::optional<std::string> o = "hi";
	CHECK(o && *o == "hi");
	std::variant<int, std::string> var = std::string("x");
	CHECK(std::holds_alternative<std::string>(var));
	try { throw std::runtime_error("boom"); } catch (const std::exception &e) { CHECK(std::string(e.what()) == "boom"); }
	try { (void)std::vector<int>().at(3); } catch (const std::out_of_range &) { std::puts("out_of_range"); }
	std::mt19937 g(42);
	CHECK(g() == 1608637542u);
	std::regex re("a(b+)c");
	std::smatch sm;
	std::string text = "xxabbbcxx";
	CHECK(std::regex_search(text, sm, re) && sm[1] == "bbb");
	auto t0 = std::chrono::steady_clock::now();
	CHECK(std::chrono::steady_clock::now() >= t0);
	std::ostringstream os;
	os << 3.5 << ' ' << std::hex << 255 << ' ' << std::string("s");
	CHECK(os.str() == "3.5 ff s");
	std::istringstream is("12 3.25 word");
	int i;
	double d;
	std::string w;
	is >> i >> d >> w;
	CHECK(i == 12 && d == 3.25 && w == "word");
	std::println("println {}", 42);
	std::cout << "done failed=" << failed << std::endl;
	return failed;
}
EOF
hosted_want="out_of_range println 42 done failed=0"
for options in "-mcpu=cortex-m0plus" "-mcpu=cortex-m3" "-mcpu=cortex-m4" "-mcpu=cortex-m4 -mfloat-abi=hard" \
	"-mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard" "-mcpu=cortex-m33" "-mcpu=cortex-m33 -mfloat-abi=hard"; do
	for speed in "" "--speed"; do
		name="hosted c++ [${options} ${speed}]"
		# shellcheck disable=SC2086
		if ! "${GXX}" ${options} ${speed} --specs=rtoskit-linux.specs -Os -std=gnu++23 "${work}/hosted.cc" -o "${work}/hosted.elf" 2> "${work}/err.txt"; then
			fail "${name}: $(grep -m1 -E 'error|undefined' "${work}/err.txt")"
			continue
		fi
		if [[ ${have_qemu} == y ]]; then
			got=$(timeout 60 qemu-arm -cpu max "${work}/hosted.elf" 2>&1 | tr '\n' ' ' | sed 's/ $//')
			check "${name}" "${hosted_want}" "${got}"
		else
			pass "${name} (linked)"
		fi
	done
done

# The same library without exceptions, without RTTI and without both (-fno-exceptions, -fno-rtti): containers,
# strings, streams and a virtual call must build and run in each mode.
cat > "${work}/noexc.cc" <<'EOF'
#include <algorithm>
#include <cstdio>
#include <functional>
#include <iostream>
#include <map>
#include <memory>
#include <numeric>
#include <sstream>
#include <string>
#include <vector>
struct Base { virtual ~Base() = default; virtual int f() const { return 1; } };
struct Derived : Base { int f() const override { return 2; } };
int main()
{
	std::vector<int> v(10);
	std::iota(v.begin(), v.end(), 1);
	std::sort(v.begin(), v.end(), std::greater<>());
	std::map<std::string, int> m{{"a", 1}, {"b", 2}};
	std::unique_ptr<Base> p = std::make_unique<Derived>();
	std::ostringstream os;
	os << v.front() << ' ' << m["b"] << ' ' << p->f();
	std::cout << os.str() << std::endl;
	std::string s = "abc";
	s += std::to_string(v.back());
	std::printf("%s\n", s.c_str());
	return 0;
}
EOF
noexc_want="10 2 2 abc1"
for mode in "-fno-exceptions" "-fno-rtti" "-fno-exceptions -fno-rtti"; do
	for options in "-mcpu=cortex-m0plus" "-mcpu=cortex-m3" "-mcpu=cortex-m4" "-mcpu=cortex-m4 -mfloat-abi=hard" \
		"-mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard" "-mcpu=cortex-m33" "-mcpu=cortex-m33 -mfloat-abi=hard"; do
		for speed in "" "--speed"; do
			name="c++ ${mode} [${options} ${speed}]"
			# shellcheck disable=SC2086
			if ! "${GXX}" ${options} ${speed} --specs=rtoskit-linux.specs -Os -std=gnu++23 ${mode} "${work}/noexc.cc" -o "${work}/noexc.elf" 2> "${work}/err.txt"; then
				fail "${name}: $(grep -m1 -E 'error|undefined' "${work}/err.txt")"
				continue
			fi
			if [[ ${have_qemu} == y ]]; then
				got=$(timeout 60 qemu-arm -cpu max "${work}/noexc.elf" 2>&1 | tr '\n' ' ' | sed 's/ $//')
				check "${name}" "${noexc_want}" "${got}"
			else
				pass "${name} (linked)"
			fi
		done
	done
done

# std::stacktrace: libbacktrace is in libstdc++exp.a, so the program links -lstdc++exp. A trace needs unwind tables in
# the program's own frames, which -fno-exceptions drops unless -funwind-tables puts them back. Capture reads no file
# on the target; the entries are only symbolised when the executable can be opened (qemu-user can, a board cannot).
# Four noinline frames below main must all be found, and to_string must produce text.
cat > "${work}/st.cc" <<'EOF'
#include <cstdio>
#include <stacktrace>
#include <string>
static int depth;
__attribute__((noinline)) static std::size_t leaf()
{
	auto t = std::stacktrace::current();
	for (const auto &e : t)
		if (!e) return 0;
	depth = int(t.size());
	return std::to_string(t).size();
}
__attribute__((noinline)) static std::size_t c() { std::size_t n = leaf(); asm volatile("" ::: "memory"); return n; }
__attribute__((noinline)) static std::size_t b() { std::size_t n = c(); asm volatile("" ::: "memory"); return n; }
__attribute__((noinline)) static std::size_t a() { std::size_t n = b(); asm volatile("" ::: "memory"); return n; }
int main()
{
	std::size_t n = a();
	std::printf("stacktrace depth>=4 %d to_string %s\n", depth >= 4, n != 0 ? "ok" : "empty");
	return 0;
}
EOF
st_want="stacktrace depth>=4 1 to_string ok"
for mode in "" "-fno-exceptions -funwind-tables"; do
	for options in "-mcpu=cortex-m0plus" "-mcpu=cortex-m3" "-mcpu=cortex-m4" "-mcpu=cortex-m4 -mfloat-abi=hard" \
		"-mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard" "-mcpu=cortex-m33" "-mcpu=cortex-m33 -mfloat-abi=hard"; do
		for speed in "" "--speed"; do
			name="stacktrace ${mode} [${options} ${speed}]"
			# shellcheck disable=SC2086
			if ! "${GXX}" ${options} ${speed} --specs=rtoskit-linux.specs -Os -std=gnu++23 ${mode} "${work}/st.cc" -o "${work}/st.elf" -lstdc++exp 2> "${work}/err.txt"; then
				fail "${name}: $(grep -m1 -E 'error|undefined' "${work}/err.txt")"
				continue
			fi
			if [[ ${have_qemu} == y ]]; then
				got=$(timeout 60 qemu-arm -cpu max "${work}/st.elf" 2>&1 | tr '\n' ' ' | sed 's/ $//')
				check "${name}" "${st_want}" "${got}"
			else
				pass "${name} (linked)"
			fi
		done
	done
done

# The C++ threading classes, over the C11 thread model (--enable-threads=c11, gthr-c11.h) and rtoskit-libc's <threads.h>:
# std::thread (join, detach, ids), the mutex classes (plain, recursive, timed, shared), condition variables (with a
# timeout), std::call_once, function-local statics initialised by several threads at once, std::future, std::promise
# and std::async (with an exception), thread_local objects with destructors, and std::atomic.
cat > "${work}/thr.cc" <<'EOF'
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdio>
#include <future>
#include <mutex>
#include <random>
#include <shared_mutex>
#include <stdexcept>
#include <thread>
#include <vector>
using namespace std::chrono_literals;

static std::atomic<int> tl_dtors{0};
struct TL { int v = 0; ~TL() { ++tl_dtors; } };
static thread_local TL tl;

static std::atomic<int> inits{0};
static int slow_init() { std::this_thread::sleep_for(5ms); return ++inits; }
static int &local_static() { static int v = slow_init(); return v; }

// Run fn in four threads at once and wait for them
template <class F> static void in_threads(F fn)
{
	std::vector<std::thread> v;
	for (int i = 0; i < 4; ++i) v.emplace_back(fn);
	for (auto &t : v) t.join();
}

int main()
{
	// std::mutex, with enough contention that the lock has to block
	std::mutex m;
	int count = 0;
	in_threads([&] { for (int i = 0; i < 1000; ++i) { std::lock_guard<std::mutex> l(m); ++count; } });
	std::printf("mutex=%d", count);

	// std::recursive_mutex: the same thread locks it twice
	std::recursive_mutex rm;
	bool rec = false;
	std::thread([&] { std::lock_guard<std::recursive_mutex> a(rm); std::lock_guard<std::recursive_mutex> b(rm); rec = true; }).join();
	std::printf(" rec=%d", rec);

	// std::timed_mutex: it times out while another thread holds it, then it is acquired
	std::timed_mutex tm;
	tm.lock();
	bool early = true, late = false;
	std::thread([&] { early = tm.try_lock_for(20ms); }).join();
	tm.unlock();
	std::thread([&] { late = tm.try_lock_for(1s); if (late) tm.unlock(); }).join();
	std::printf(" timed=%d,%d", early, late);

	// std::condition_variable: a hand-off, and a wait_for that times out
	std::mutex cm;
	std::condition_variable cv;
	bool ready = false;
	int got = 0;
	std::thread consumer([&] { std::unique_lock<std::mutex> l(cm); cv.wait(l, [&] { return ready; }); got = 1; });
	std::this_thread::sleep_for(10ms);
	{ std::lock_guard<std::mutex> l(cm); ready = true; }
	cv.notify_all();
	consumer.join();
	std::unique_lock<std::mutex> l(cm);
	bool timed_out = cv.wait_for(l, 20ms) == std::cv_status::timeout;
	l.unlock();
	std::printf(" cv=%d,%d", got, timed_out);

	// std::call_once from four threads, and a function-local static initialised by four at once
	std::once_flag once;
	std::atomic<int> ran{0};
	in_threads([&] { std::call_once(once, [&] { std::this_thread::sleep_for(5ms); ++ran; }); });
	std::printf(" once=%d", ran.load());
	// An exception from the function of a std::call_once leaves the flag unset, so the next call runs it again
	std::once_flag eflag;
	int attempts = 0;
	bool threw = false;
	try { std::call_once(eflag, [&] { ++attempts; throw std::runtime_error("x"); }); }
	catch (const std::runtime_error &) { threw = true; }
	std::call_once(eflag, [&] { ++attempts; });
	std::call_once(eflag, [&] { ++attempts; });
	std::printf(" onceexc=%d,%d", threw, attempts);
	// std::random_device reads getentropy
	std::random_device rd;
	unsigned first = rd();
	bool varies = false;
	for (int i = 0; i < 8; ++i) varies |= rd() != first;
	std::printf(" random=%d", varies);
	in_threads([&] { local_static(); });
	std::printf(" static=%d,%d", inits.load(), local_static());

	// std::future, std::promise and std::async, and an exception that travels through the future
	std::promise<int> p;
	std::future<int> pf = p.get_future();
	std::thread([&] { p.set_value(7); }).detach();
	int async_value = std::async(std::launch::async, [] { return 42; }).get();
	std::printf(" future=%d,%d", async_value, pf.get());
	bool caught = false;
	try { std::async(std::launch::async, [] () -> int { throw std::runtime_error("x"); }).get(); }
	catch (const std::runtime_error &) { caught = true; }
	std::printf(" exc=%d", caught);

	// A thread_local object is destroyed when its thread ends
	std::thread([] { tl.v = 1; }).join();
	std::printf(" tldtor=%d", tl_dtors.load());

	// A detached thread runs on its own
	std::atomic<int> detached{0};
	std::thread([&] { detached = 1; }).detach();
	for (int i = 0; i < 100 && !detached; ++i) std::this_thread::sleep_for(10ms);
	std::printf(" detach=%d", detached.load());

	// Thread ids: the main thread is not "no thread", a thread's id is the one its handle reports
	std::thread::id inner;
	std::thread t([&] { inner = std::this_thread::get_id(); });
	std::thread::id outer = t.get_id();
	t.join();
	std::printf(" id=%d", std::this_thread::get_id() != std::thread::id() && inner == outer && !t.joinable());

	// std::shared_mutex: another thread can share a shared lock but not take it exclusively
	std::shared_mutex sm;
	sm.lock_shared();
	bool shared = false, exclusive = true;
	std::thread([&] { shared = sm.try_lock_shared(); if (shared) sm.unlock_shared(); exclusive = sm.try_lock(); }).join();
	sm.unlock_shared();
	std::printf(" shared=%d,%d\n", shared, exclusive);
	return 0;
}
EOF
thr_want="mutex=4000 rec=1 timed=0,1 cv=1,1 once=1 onceexc=1,2 random=1 static=1,1 future=42,7 exc=1 tldtor=1 detach=1 id=1 shared=1,0"
for options in "-mcpu=cortex-m0plus" "-mcpu=cortex-m3" "-mcpu=cortex-m4" "-mcpu=cortex-m4 -mfloat-abi=hard" \
	"-mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard" "-mcpu=cortex-m33" "-mcpu=cortex-m33 -mfloat-abi=hard"; do
	for speed in "" "--speed"; do
		name="threads [${options} ${speed}]"
		# shellcheck disable=SC2086
		if ! "${GXX}" ${options} ${speed} --specs=rtoskit-linux.specs -Os -std=gnu++23 "${work}/thr.cc" -o "${work}/thr.elf" 2> "${work}/err.txt"; then
			fail "${name}: $(grep -m1 -E 'error|undefined' "${work}/err.txt")"
			continue
		fi
		if [[ ${have_qemu} == y ]]; then
			got=$(timeout 120 qemu-arm -cpu max "${work}/thr.elf" 2>&1 | tr '\n' ' ' | sed 's/ $//')
			check "${name}" "${thr_want}" "${got}"
		else
			pass "${name} (linked)"
		fi
	done
done

# The clocks and the sleeps under <chrono> and <thread>: libstdc++ reads CLOCK_REALTIME and CLOCK_MONOTONIC through
# clock_gettime, sleeps in nanosleep and yields through thrd_yield (0002-libstdcxx-add-rtoskit-libc-os-port.patch).
# A fallback on time() would pass the threads test above, but its one-second steps show here: a 50 ms sleep would
# measure 0 or 1000 ms. The upper bounds are ten times the request so that a loaded machine does not fail them.
cat > "${work}/clk.cc" <<'EOF'
#include <chrono>
#include <condition_variable>
#include <cstdio>
#include <mutex>
#include <thread>
using namespace std::chrono;
using namespace std::chrono_literals;

// Whether a measured time is at least the request and well short of a second
static bool within(nanoseconds elapsed, nanoseconds request, nanoseconds limit)
{
	return elapsed >= request && elapsed < limit;
}

int main()
{
	// steady_clock never goes backwards
	bool mono = true;
	auto last = steady_clock::now();
	for (int i = 0; i < 1000; ++i) {
		auto now = steady_clock::now();
		if (now < last) mono = false;
		last = now;
	}
	std::printf("mono=%d", mono);

	// sleep_for sleeps at least as long as asked, on both clocks, with sub-second resolution
	auto s0 = steady_clock::now();
	auto w0 = system_clock::now();
	std::this_thread::sleep_for(50ms);
	auto s1 = steady_clock::now();
	auto w1 = system_clock::now();
	std::printf(" sleep=%d,%d", within(s1 - s0, 50ms, 500ms), within(w1 - w0, 50ms, 500ms));

	// condition_variable::wait_for times out after the time asked, not early and not a second late
	std::mutex m;
	std::condition_variable cv;
	std::unique_lock<std::mutex> l(m);
	auto c0 = steady_clock::now();
	bool timed_out = cv.wait_for(l, 100ms) == std::cv_status::timeout;
	auto c1 = steady_clock::now();
	std::printf(" wait=%d", timed_out && within(c1 - c0, 100ms, 1s));
	l.unlock();

	// timed_mutex::try_lock_for gives up after the time asked
	std::timed_mutex tm;
	tm.lock();
	bool locked = true;
	nanoseconds waited{};
	std::thread([&] {
		auto t0 = steady_clock::now();
		locked = tm.try_lock_for(100ms);
		waited = steady_clock::now() - t0;
	}).join();
	std::printf(" lock=%d", !locked && within(waited, 100ms, 1s));

	// yield returns, and the clock still moves forward afterwards
	for (int i = 0; i < 100; ++i) std::this_thread::yield();
	std::printf(" yield=%d\n", steady_clock::now() >= last);
	return 0;
}
EOF
clk_want="mono=1 sleep=1,1 wait=1 lock=1 yield=1"
for options in "-mcpu=cortex-m0plus" "-mcpu=cortex-m3" "-mcpu=cortex-m4" "-mcpu=cortex-m4 -mfloat-abi=hard" \
	"-mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard" "-mcpu=cortex-m33" "-mcpu=cortex-m33 -mfloat-abi=hard"; do
	for speed in "" "--speed"; do
		name="clocks [${options} ${speed}]"
		# shellcheck disable=SC2086
		if ! "${GXX}" ${options} ${speed} --specs=rtoskit-linux.specs -Os -std=gnu++23 "${work}/clk.cc" -o "${work}/clk.elf" 2> "${work}/err.txt"; then
			fail "${name}: $(grep -m1 -E 'error|undefined' "${work}/err.txt")"
			continue
		fi
		if [[ ${have_qemu} == y ]]; then
			got=$(timeout 60 qemu-arm -cpu max "${work}/clk.elf" 2>&1 | tr '\n' ' ' | sed 's/ $//')
			check "${name}" "${clk_want}" "${got}"
		else
			pass "${name} (linked)"
		fi
	done
done

# libstdc++ is configured from <rtoskit-libc.h> (0002-libstdcxx-add-rtoskit-libc-os-port.patch): the library defines
# __LIBC_HAVE_<NAME> for each feature it has, and configure's compile tests turn each into libstdc++'s HAVE_<NAME>
# (_GLIBCXX_USE_<NAME> for the clocks, nanosleep and sched_yield). The names are read from the installed header, so a
# feature the library adds and the patch does not ask about shows here. The library's own tests check that each one is
# declared and linked.
printf '#include <rtoskit-libc.h>\n#include <bits/c++config.h>\n' > "${work}/features.cc"
for name in $(echo '#include <rtoskit-libc.h>' | "${GXX}" -dM -E -x c++ - 2> /dev/null | sed -n 's/^#define __LIBC_HAVE_\([A-Z0-9_]*\) 1$/\1/p'); do
	case ${name} in
	CLOCK_REALTIME | CLOCK_MONOTONIC | NANOSLEEP | SCHED_YIELD) macro=_GLIBCXX_USE_${name} ;;
	*) macro=_GLIBCXX_HAVE_${name} ;;
	esac
	printf '#ifndef %s\n#error libstdc++ lacks %s\n#endif\n' "${macro}" "${macro}" >> "${work}/features.cc"
done
if [[ $(grep -c '^#ifndef' "${work}/features.cc") -lt 60 ]]; then
	fail "libstdc++ features: <rtoskit-libc.h> names fewer than 60 features"
elif "${GXX}" -fsyntax-only -std=gnu++23 "${work}/features.cc" 2> "${work}/err.txt"; then
	pass "libstdc++ features: everything <rtoskit-libc.h> names"
else
	fail "libstdc++ features: $(grep -o 'libstdc++ lacks [A-Za-z0-9_]*' "${work}/err.txt" | sed 's/libstdc++ lacks //' | tr '\n' ' ' | sed 's/ $//')"
fi

# The C11 thread model must not reach C: a C program (no threads of its own) links none of the library's mutex,
# condition variable, thread, key or call_once functions.
cat > "${work}/plain.c" <<'EOF'
#include <stdio.h>
#include <math.h>
int main(int argc, char **argv) { (void) argv; printf("%f\n", sinf((float) argc)); return 0; }
EOF
NM=${GCC%gcc}nm
for options in "-mcpu=cortex-m0plus" "-mcpu=cortex-m4 -mfloat-abi=hard" "-mcpu=cortex-m33"; do
	name="c without threads [${options}]"
	# shellcheck disable=SC2086
	if ! "${GCC}" ${options} --specs=rtoskit-linux.specs -Os "${work}/plain.c" -o "${work}/plain.elf" 2> "${work}/err.txt"; then
		fail "${name}: $(head -1 "${work}/err.txt")"
		continue
	fi
	used=$("${NM}" "${work}/plain.elf" | grep -E ' [TtWw] (mtx_|cnd_|thrd_|tss_|call_once)' | awk '{print $3}' | tr '\n' ' ' | sed 's/ $//')
	check "${name}" "" "${used}"
done

# The library variants and the port choose the expected archives
archive_check() { # archive_check <options> <expected archives>
	printf '#include <stdio.h>\nint main(void) { printf("%%d\\n", 42); return 0; }\n' > "${work}/pf.c"
	# shellcheck disable=SC2086
	got=$("${GCC}" -mcpu=cortex-m4 -mfloat-abi=hard --specs=rtoskit.specs $1 -Os "${work}/pf.c" -o "${work}/pf.elf" -Wl,--trace 2>&1 |
		grep -oE 'thumb/[^ ]*lib(c|rtos)[^ ]*\.a' | sed -E 's|.*/||' | sort -u | tr '\n' ' ')
	check "archives [$1]" "$2" "${got}"
}
archive_check "" "libc.a librtos-none.a "
archive_check "--libc=minimal-printf" "libc-minimal-printf.a librtos-none.a "
archive_check "--libc=nofloat" "libc-nofloat.a librtos-none.a "
archive_check "--libc=tinymalloc" "libc-tinymalloc.a librtos-none.a "

echo
if [[ ${failures} -eq 0 ]]; then
	echo "validate-toolchain: all checks passed"
else
	echo "validate-toolchain: ${failures} check(s) failed"
fi
exit $((failures > 0))
