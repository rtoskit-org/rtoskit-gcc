# file, You can obtain one at http://mozilla.org/MPL/2.0/.
#
# gcc-releases
#
# Keeps the GCC releases built by compilers/arm-none-eabi current: the latest minor
# release of each of the last three majors.
#
# Created on: Oct 29, 2026
#     Author: Stephen Street (stephen@redrocketcomputing.com)
#

set -eu
set -o pipefail

if [[ -z "${PROJECT_ROOT:-}" ]]; then
	PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
fi

GCC_FTP=${GCC_FTP:-https://ftp.gnu.org/gnu/gcc}
MAJORS=3

COMPILER_DIR=${PROJECT_ROOT}/compilers/arm-none-eabi
VERSIONS_INC=${COMPILER_DIR}/versions.inc
OVERLAY=${COMPILER_DIR}/crosstool-ng
REMOVE_LIST=${COMPILER_DIR}/crosstool-ng.remove
LIBC_PKG=${OVERLAY}/packages/rtoskit
CTNG_REPO=${CTNG_REPO:-https://github.com/crosstool-ng/crosstool-ng}
CTNG_RAW=${CTNG_RAW:-https://raw.githubusercontent.com/crosstool-ng/crosstool-ng}
LIBC_REPO=${LIBC_REPO:-https://github.com/rtoskit-org/rtoskit-libc}
DOWNLOADS=${PROJECT_ROOT}/downloads

dry_run=
ctng_target=

usage() {
	cat <<EOF
Usage: gcc-releases [options] <command>

Commands:
  check              Show the configured versions, the newest releases on ${GCC_FTP}
                     and whether crosstool-NG packages them. Changes nothing.
  update             Move every configured major to its newest minor release.
  rotate [MAJOR]     Add the newest released major (or MAJOR) and drop the oldest, then
                     update. With 17 released, 16 15 14 becomes 17 16 15.
  bump-libc [VERSION]  Build with rtoskit-libc release VERSION (default: the newest v* tag): fetch its
                     source archive, write the crosstool-NG package with its digests, set RTOSKIT_LIBC_VERSION.

Options:
  --dry-run          Show what would change; write nothing.
  --ct-ng=REF|latest Move the crosstool-NG commit to REF (or its master) when the pinned
                     commit does not package a needed version.

Files changed (never committed or staged):
  ${VERSIONS_INC#${PROJECT_ROOT}/}   GCC_VERSIONS, RTOSKIT_LIBC_VERSION, CROSSTOOL_NG_REV and CROSSTOOL_NG_SHA256
  compilers/arm-none-eabi/crosstool-ng/packages/rtoskit/<version>/
                                      the rtoskit-libc release package (bump-libc)
  compilers/arm-none-eabi/crosstool-ng/packages/gcc/<version>/
                                      only when no crosstool-NG commit has the version
EOF
}

die() {
	echo "gcc-releases: $*" >&2
	exit 1
}

note() {
	echo "$*"
}

# The configured versions, newest first
configured() {
	sed -n 's/^GCC_VERSIONS *[?:]*= *//p' "${VERSIONS_INC}" | head -1
}

# Every release on the GNU mirror, oldest first
ftp_versions() {
	if [[ -z "${ftp_cache:-}" ]]; then
		ftp_cache=$(curl -fsSL "${GCC_FTP}/" | grep -oE 'gcc-[0-9]+\.[0-9]+\.[0-9]+/' | sed -e 's/^gcc-//' -e 's|/$||' | sort -uV)
		[[ -n "${ftp_cache}" ]] || die "no GCC releases found at ${GCC_FTP}"
	fi
	echo "${ftp_cache}"
}

major_of() {
	echo "${1%%.*}"
}

# The newest minor release of a major, or nothing
latest_of_major() {
	ftp_versions | grep -E "^$1\\." | tail -1 || true
}

newest_major() {
	ftp_versions | tail -1 | cut -d. -f1
}

# A variable of versions.inc
inc_get() {
	sed -n "s/^$1 *[?:]*= *//p" "${VERSIONS_INC}" | head -1
}

inc_set() {
	sed -i "s/^\\($1 *[?:]*= *\\).*/\\1$2/" "${VERSIONS_INC}"
}

# The commit a crosstool-NG ref (a branch, a tag or a commit) names
ctng_resolve() {
	local ref=$1
	if [[ ${ref} =~ ^[0-9a-f]{40}$ ]]; then
		echo "${ref}"
		return
	fi
	git ls-remote "${CTNG_REPO}.git" "${ref}" "refs/heads/${ref}" "refs/tags/${ref}" | head -1 | cut -f1
}

ctng_head() {
	git ls-remote "${CTNG_REPO}.git" refs/heads/master | cut -f1
}

# Does a crosstool-NG revision package a GCC version? (an overlay package counts for any revision)
ctng_has() {
	local rev=$1 version=$2
	[[ -f "${OVERLAY}/packages/gcc/${version}/chksum" ]] && return 0
	curl -fsIL -o /dev/null "${CTNG_RAW}/${rev}/packages/gcc/${version}/chksum" 2>/dev/null
}

# The source archive of a crosstool-NG commit, in downloads/ (printed)
ctng_archive() {
	local rev=$1 file="${DOWNLOADS}/crosstool-ng-$1.tar.gz"
	if [[ ! -f "${file}" ]]; then
		mkdir -p "${DOWNLOADS}"
		curl -fsSL --retry 3 -o "${file}.part" "${CTNG_REPO}/archive/${rev}.tar.gz" || die "cannot download crosstool-NG ${rev}"
		mv "${file}.part" "${file}"
	fi
	echo "${file}"
}

write_versions() {
	if [[ -n "${dry_run}" ]]; then
		note "would set GCC_VERSIONS to: $1"
		return
	fi
	sed -i "s/^\\(GCC_VERSIONS *[?:]*= *\\).*/\\1$1/" "${VERSIONS_INC}"
	note "GCC_VERSIONS = $1"
}

cmd_check() {
	local version latest rev_pin rev_head newest
	rev_pin=$(inc_get CROSSTOOL_NG_REV)
	rev_head=$(ctng_head)

	printf '%-10s %-10s %-9s %-9s %s\n' MAJOR CONFIGURED NEWEST "PINNED-NG" "NG-MASTER"
	for version in $(configured); do
		latest=$(latest_of_major "$(major_of "${version}")")
		printf '%-10s %-10s %-9s %-9s %s\n' "$(major_of "${version}")" "${version}" "${latest:-none}" \
			"$(ctng_has "${rev_pin}" "${latest:-none}" && echo yes || echo no)" \
			"$(ctng_has "${rev_head}" "${latest:-none}" && echo yes || echo no)"
	done
	newest=$(newest_major)
	note ""
	note "newest released major: ${newest}"
	note "crosstool-NG pinned:   ${rev_pin:0:12}  master: ${rev_head:0:12}"
	note "rtoskit-libc release:  $(inc_get RTOSKIT_LIBC_VERSION)  newest tag: $(libc_newest)"
	if [[ " $(configured) " != *" $(latest_of_major "${newest}") "* ]]; then
		note "a newer major than the configured set exists: run 'gcc-releases rotate'"
	fi
}

# Create the overlay package packages/gcc/<version> when no crosstool-NG revision has it:
# the patches of the same major (or the nearest lower one), and the archive digests.
make_overlay() {
	local version=$1 major rev have src old tmp
	major=$(major_of "${version}")
	rev=$(ctng_head)

	if [[ -n "${dry_run}" ]]; then
		note "would create overlay packages/gcc/${version} (no crosstool-NG revision packages it)"
		return
	fi

	# The nearest package to start from: the same major, else the newest lower one
	tmp=$(mktemp -d)
	tar -xzf "$(ctng_archive "${rev}")" -C "${tmp}" --strip-components=1 --wildcards '*/packages/gcc'
	have=$(find "${tmp}/packages/gcc" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V)
	src=$(echo "${have}" | grep -E "^${major}\\." | tail -1 || true)
	if [[ -z "${src}" ]]; then
		src=$(echo "${have}" | awk -F. -v m="${major}" '$1 < m' | tail -1)
		note "warning: crosstool-NG has no GCC ${major}; starting from the patches of ${src}, which may not apply"
	fi
	[[ -n "${src}" ]] || die "no crosstool-NG package to start ${version} from"

	mkdir -p "${OVERLAY}/packages/gcc/${version}"
	cp -a "${tmp}/packages/gcc/${src}/." "${OVERLAY}/packages/gcc/${version}/"

	# Digests of the .tar.xz, the first of the package's archive formats
	mkdir -p "${DOWNLOADS}"
	if [[ ! -f "${DOWNLOADS}/gcc-${version}.tar.xz" ]]; then
		curl -fsSL -o "${DOWNLOADS}/gcc-${version}.tar.xz" "${GCC_FTP}/gcc-${version}/gcc-${version}.tar.xz"
	fi
	: > "${OVERLAY}/packages/gcc/${version}/chksum"
	for alg in md5 sha1 sha256 sha512; do
		echo "${alg} gcc-${version}.tar.xz $(${alg}sum "${DOWNLOADS}/gcc-${version}.tar.xz" | cut -d' ' -f1)" >> "${OVERLAY}/packages/gcc/${version}/chksum"
	done
	note "created overlay packages/gcc/${version} from ${src}"

	# crosstool-NG allows one package per major: drop the one this replaces
	for old in ${have}; do
		if [[ "$(major_of "${old}")" == "${major}" && "${old}" != "${version}" ]]; then
			touch "${REMOVE_LIST}"
			grep -qx "packages/gcc/${old}" "${REMOVE_LIST}" || echo "packages/gcc/${old}" >> "${REMOVE_LIST}"
			note "removing crosstool-NG's packages/gcc/${old} (listed in crosstool-ng.remove)"
		fi
	done

	# A new major also has to be in the package's milestones
	if ! grep -q "^milestones=.* ${major}'" "${tmp}/packages/gcc/package.desc"; then
		sed "s/^\\(milestones='.*\\)'/\\1 ${major}'/" "${tmp}/packages/gcc/package.desc" > "${OVERLAY}/packages/gcc/package.desc"
		note "added ${major} to the milestones in the overlay packages/gcc/package.desc"
	fi
	rm -rf "${tmp}"
}

# Make sure some crosstool-NG revision packages every version in the list
ensure_ctng() {
	local version rev_pin rev_head missing='' sha
	rev_pin=$(inc_get CROSSTOOL_NG_REV)
	for version in "$@"; do
		ctng_has "${rev_pin}" "${version}" || missing="${missing} ${version}"
	done
	[[ -n "${missing}" ]] || return 0

	rev_head=$(ctng_head)
	local move_to=''
	case "${ctng_target}" in
		latest) move_to=${rev_head} ;;
		"") ;;
		*) move_to=$(ctng_resolve "${ctng_target}")
		   [[ -n "${move_to}" ]] || die "no such crosstool-NG ref: ${ctng_target}" ;;
	esac

	if [[ -n "${move_to}" ]]; then
		for version in ${missing}; do
			ctng_has "${move_to}" "${version}" || note "warning: crosstool-NG ${move_to:0:12} does not package ${version} either"
		done
		if [[ -n "${dry_run}" ]]; then
			note "would move crosstool-NG to ${move_to:0:12}"
		else
			sha=$(sha256sum "$(ctng_archive "${move_to}")" | cut -d' ' -f1)
			inc_set CROSSTOOL_NG_REV "${move_to}"
			inc_set CROSSTOOL_NG_SHA256 "${sha}"
			note "crosstool-NG -> ${move_to:0:12} (CROSSTOOL_NG_REV and CROSSTOOL_NG_SHA256 in versions.inc)"
		fi
		for version in ${missing}; do
			ctng_has "${move_to}" "${version}" || make_overlay "${version}"
		done
	else
		note "crosstool-NG ${rev_pin:0:12} does not package:${missing}"
		for version in ${missing}; do
			if ctng_has "${rev_head}" "${version}"; then
				note "  ${version}: packaged by crosstool-NG master ${rev_head:0:12}; rerun with --ct-ng=latest to move to it"
			else
				note "  ${version}: not packaged by crosstool-NG master either; generating an overlay package"
				make_overlay "${version}"
			fi
		done
	fi
}

cmd_update() {
	local current version latest new=''
	current=$(configured)
	[[ -n "${current}" ]] || die "no GCC_VERSIONS in ${VERSIONS_INC}"
	for version in ${current}; do
		latest=$(latest_of_major "$(major_of "${version}")")
		[[ -n "${latest}" ]] || die "no release of GCC $(major_of "${version}") at ${GCC_FTP}"
		if [[ "${latest}" != "${version}" ]]; then
			note "GCC $(major_of "${version}"): ${version} -> ${latest}"
		else
			note "GCC $(major_of "${version}"): ${version} is current"
		fi
		new="${new:+${new} }${latest}"
	done
	# shellcheck disable=SC2086
	ensure_ctng ${new}
	[[ "${new}" == "${current}" ]] || write_versions "${new}"
}

cmd_rotate() {
	local add=${1:-} current version major latest new=''
	[[ -n "${add}" ]] || add=$(newest_major)
	current=$(configured)
	for version in ${current}; do
		if [[ "$(major_of "${version}")" == "${add}" ]]; then
			note "GCC ${add} is already configured"
			cmd_update
			return
		fi
	done
	[[ -n "$(latest_of_major "${add}")" ]] || die "no release of GCC ${add} at ${GCC_FTP}"

	# The newest MAJORS majors, each at its latest minor release
	for major in $( (echo "${add}"; for version in ${current}; do major_of "${version}"; done) | sort -rnu | head -"${MAJORS}"); do
		latest=$(latest_of_major "${major}")
		[[ -n "${latest}" ]] || die "no release of GCC ${major} at ${GCC_FTP}"
		new="${new:+${new} }${latest}"
	done
	note "rotating: ${current} -> ${new}"
	# shellcheck disable=SC2086
	ensure_ctng ${new}
	write_versions "${new}"
}

# The newest v<version> tag of rtoskit-libc, without the v
libc_newest() {
	git ls-remote --tags --refs "${LIBC_REPO}.git" 'v[0-9]*' | sed -n 's|.*refs/tags/v||p' | sort -V | tail -1
}

# Build with an rtoskit-libc release: crosstool-NG downloads the tag's source archive (packages/rtoskit/<version>), so
# the package carries the digests of that archive. Only one release is packaged at a time.
cmd_bump_libc() {
	local version=${1:-} file alg dir
	version=${version#v}
	[[ -n "${version}" ]] || version=$(libc_newest)
	[[ -n "${version}" ]] || die "no rtoskit-libc release found at ${LIBC_REPO}"
	if [[ -n "${dry_run}" ]]; then
		note "would build with rtoskit-libc ${version} (was $(inc_get RTOSKIT_LIBC_VERSION))"
		return
	fi
	file="${DOWNLOADS}/v${version}.tar.gz"
	mkdir -p "${DOWNLOADS}"
	curl -fsSL --retry 3 -o "${file}.part" "${LIBC_REPO}/archive/refs/tags/v${version}.tar.gz" || die "cannot download rtoskit-libc v${version}"
	mv "${file}.part" "${file}"
	for dir in "${LIBC_PKG}"/*/; do
		[[ -d "${dir}" && "${dir%/}" != "${LIBC_PKG}/${version}" ]] && rm -rf "${dir}"
	done
	mkdir -p "${LIBC_PKG}/${version}"
	: > "${LIBC_PKG}/${version}/version.desc"
	: > "${LIBC_PKG}/${version}/chksum"
	for alg in md5 sha1 sha256 sha512; do
		echo "${alg} v${version}.tar.gz $(${alg}sum "${file}" | cut -d' ' -f1)" >> "${LIBC_PKG}/${version}/chksum"
	done
	inc_set RTOSKIT_LIBC_VERSION "${version}"
	note "rtoskit-libc ${version}: packages/rtoskit/${version}/chksum written, RTOSKIT_LIBC_VERSION set"
}

command=
args=()
for arg in "$@"; do
	case "${arg}" in
		--dry-run) dry_run=y ;;
		--ct-ng=*) ctng_target=${arg#--ct-ng=} ;;
		-h|--help) usage; exit 0 ;;
		-*) die "unknown option ${arg}" ;;
		*) if [[ -z "${command}" ]]; then command=${arg}; else args+=("${arg}"); fi ;;
	esac
done

[[ -f "${VERSIONS_INC}" ]] || die "missing ${VERSIONS_INC}"

case "${command}" in
	check) cmd_check ;;
	update) cmd_update ;;
	rotate) cmd_rotate "${args[0]:-}" ;;
	bump-libc) cmd_bump_libc "${args[0]:-}" ;;
	"") usage; exit 1 ;;
	*) die "unknown command ${command}" ;;
esac
