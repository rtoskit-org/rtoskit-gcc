CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_LOCAL_TARBALLS_DIR="@PROJECT_ROOT@/downloads"
CT_PREFIX_DIR="${CT_TOP_DIR}/${TOOLCHAIN_NAME}"
# CT_REMOVE_DOCS is not set
@BUILD_MANUALS@
@PROGRESS_BAR@
# CT_PREFIX_DIR_RO is not set
CT_PATCH_BUNDLED_LOCAL=y
CT_LOCAL_PATCH_DIR="@PATCH_DIR@"
CT_PARALLEL_JOBS=0
CT_ARCH_ARM=y
CT_MULTILIB=y
CT_TARGET_CFLAGS="-ftls-model=local-exec"
CT_TARGET_VENDOR="none"
CT_TOOLCHAIN_CMAKE_TOOLCHAIN_FILE=y
CT_BINUTILS_PLUGINS=y
CT_LIBC_RTOSKIT=y
CT_RTOSKIT_SRC_CUSTOM=y
CT_RTOSKIT_CUSTOM_LOCATION="@PROJECT_ROOT@/external/rtoskit-libc"
CT_LIBC_RTOSKIT_MULTILIB_MAP="@SOURCE_DIR@/rtoskit/multilib.map"
CT_LIBC_RTOSKIT_BUILD_TYPES="release speed"
CT_LIBC_RTOSKIT_SPECS="@SOURCE_DIR@/rtoskit/rtoskit.specs @SOURCE_DIR@/rtoskit/rtoskit-linux.specs"
CT_GCC_V_@GCC_MAJOR@=y
CT_CC_GCC_MULTILIB_LIST="@t-rtoskit"
CT_CC_GCC_CORE_EXTRA_CONFIG_ARRAY="'--with-specs=%{!ftls-model=*:-ftls-model=local-exec}' --with-arch=armv6s-m --with-mode=thumb --with-float=soft"
CT_CC_GCC_EXTRA_CONFIG_ARRAY="'--with-specs=%{!ftls-model=*:-ftls-model=local-exec}' --with-arch=armv6s-m --with-mode=thumb --with-float=soft --disable-wchar_t --with-rtoskit-libc --enable-clocale=generic --enable-cstdio=stdio --without-headers --enable-threads=c11"
CT_CC_GCC_CONFIG_TLS=y
CT_CC_LANG_CXX=y
CT_CC_GCC_LIBSTDCXX=y
CT_CC_GCC_LIBSTDCXX_TARGET_CXXFLAGS="-D_GLIBCXX_HAVE___CXA_THREAD_ATEXIT=1"
CT_DEBUG_GDB=y
