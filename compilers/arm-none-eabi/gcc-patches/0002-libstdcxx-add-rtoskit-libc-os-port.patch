libstdc++: add an rtoskit-libc OS port (--with-rtoskit-libc)

libstdc++'s configure runs no link tests on a cross target. --with-newlib and
--with-picolibc hard-code what those libraries provide; with neither, the
generic cross configuration needs a linkable target.

--with-rtoskit-libc selects config/os/generic, which needs only the ISO
<ctype.h> functions, and asks the library what it provides the way the
--with-picolibc branch does: the library installs <rtoskit-libc.h>, which
defines __LIBC_HAVE_<NAME> for each feature it has (the float math functions
and their long double forms, strtof, aligned_alloc, quick_exit and
at_quick_exit, thread-local storage and __cxa_thread_atexit, S_ISREG,
getentropy, <sys/types.h>, <sys/stat.h>, <inttypes.h>, <fcntl.h> and <unistd.h>,
and the POSIX clocks, nanosleep and sched_yield that std::chrono's clocks,
std::this_thread::sleep_for and std::this_thread::yield use), and a compile test
against that header defines libstdc++'s HAVE_<NAME>, or _GLIBCXX_USE_<NAME> for
the four time names. Which names libstdc++ asks about is here; whether the
library has each is the library's, which tests the header against its archives.
The probes compile as C in the compiler's default dialect, and the header is only
macros. Names the header lacks (memalign, link, setenv, sleep, ...) stay
undefined.

The patch is the same for configure.ac and the generated configure, so no
autoconf run is needed. It applies to GCC 14, 15 and 16.

diff -ruN a/libstdc++-v3/configure b/libstdc++-v3/configure
--- a/libstdc++-v3/configure
+++ b/libstdc++-v3/configure
@@ -27525,7 +27525,62 @@
 
   # First, test for "known" system libraries.  We may be using newlib even
   # on a hosted environment.
-  if test "x${with_newlib}" = "xyes"; then
+  if test "x${with_rtoskit_libc}" = "xyes"; then
+    # rtoskit-libc: configure runs no link tests on a cross target, so ask the library what it provides, as the
+    # picolibc block does. <rtoskit-libc.h> defines __LIBC_HAVE_<NAME> for each feature the library has, and a
+    # compile test against the installed headers finds each one. Which names libstdc++ asks about stays here;
+    # whether the library has each is the library's.
+    os_include_dir="os/generic"
+    for name in ACOSF ACOSL ALIGNED_ALLOC ASINF ASINL ATAN2F ATAN2L ATANF ATANL AT_QUICK_EXIT CEILF CEILL COSF COSHF COSHL \
+    COSL __CXA_THREAD_ATEXIT EXPF EXPL FABSF FABSL FCNTL_H FLOORF FLOORL FMODF FMODL FREXPF FREXPL GETENTROPY \
+    HYPOT HYPOTF HYPOTL INTTYPES_H LDEXPF LDEXPL LOG10F LOG10L LOGF LOGL MODFF MODFL POWF POWL QUICK_EXIT SINF \
+    SINHF SINHL SINL S_ISREG SQRTF SQRTL STRTOF SYS_STAT_H SYS_TYPES_H TANF TANHF TANHL TANL TLS UNISTD_H; do
+      cat confdefs.h - <<_ACEOF >conftest.$ac_ext
+/* end confdefs.h.  */
+#include <rtoskit-libc.h>
+int
+main ()
+{
+
+        #ifndef __LIBC_HAVE_$name
+        #error
+        #endif
+  ;
+  return 0;
+}
+_ACEOF
+if ac_fn_c_try_compile "$LINENO"; then :
+  cat >>confdefs.h <<_ACEOF
+#define HAVE_$name 1
+_ACEOF
+
+fi
+rm -f core conftest.err conftest.$ac_objext conftest.$ac_ext
+    done
+    for name in CLOCK_REALTIME CLOCK_MONOTONIC NANOSLEEP SCHED_YIELD; do
+      cat confdefs.h - <<_ACEOF >conftest.$ac_ext
+/* end confdefs.h.  */
+#include <rtoskit-libc.h>
+int
+main ()
+{
+
+        #ifndef __LIBC_HAVE_$name
+        #error
+        #endif
+  ;
+  return 0;
+}
+_ACEOF
+if ac_fn_c_try_compile "$LINENO"; then :
+  cat >>confdefs.h <<_ACEOF
+#define _GLIBCXX_USE_$name 1
+_ACEOF
+
+fi
+rm -f core conftest.err conftest.$ac_objext conftest.$ac_ext
+    done
+  elif test "x${with_newlib}" = "xyes"; then
     os_include_dir="os/newlib"
     $as_echo "#define HAVE_HYPOT 1" >>confdefs.h
 
diff -ruN a/libstdc++-v3/configure.ac b/libstdc++-v3/configure.ac
--- a/libstdc++-v3/configure.ac
+++ b/libstdc++-v3/configure.ac
@@ -338,7 +338,28 @@
 
   # First, test for "known" system libraries.  We may be using newlib even
   # on a hosted environment.
-  if test "x${with_newlib}" = "xyes"; then
+  if test "x${with_rtoskit_libc}" = "xyes"; then
+    # rtoskit-libc: configure runs no link tests on a cross target, so ask the library what it provides, as the
+    # picolibc block does. <rtoskit-libc.h> defines __LIBC_HAVE_<NAME> for each feature the library has, and a
+    # compile test against the installed headers finds each one. Which names libstdc++ asks about stays here;
+    # whether the library has each is the library's.
+    os_include_dir="os/generic"
+    for name in ACOSF ACOSL ALIGNED_ALLOC ASINF ASINL ATAN2F ATAN2L ATANF ATANL AT_QUICK_EXIT CEILF CEILL COSF COSHF COSHL \
+    COSL __CXA_THREAD_ATEXIT EXPF EXPL FABSF FABSL FCNTL_H FLOORF FLOORL FMODF FMODL FREXPF FREXPL GETENTROPY \
+    HYPOT HYPOTF HYPOTL INTTYPES_H LDEXPF LDEXPL LOG10F LOG10L LOGF LOGL MODFF MODFL POWF POWL QUICK_EXIT SINF \
+    SINHF SINHL SINL S_ISREG SQRTF SQRTL STRTOF SYS_STAT_H SYS_TYPES_H TANF TANHF TANHL TANL TLS UNISTD_H; do
+      AC_TRY_COMPILE([#include <rtoskit-libc.h>], [
+        #ifndef __LIBC_HAVE_$name
+        #error
+        #endif], [AC_DEFINE_UNQUOTED([HAVE_$name], 1)], [])
+    done
+    for name in CLOCK_REALTIME CLOCK_MONOTONIC NANOSLEEP SCHED_YIELD; do
+      AC_TRY_COMPILE([#include <rtoskit-libc.h>], [
+        #ifndef __LIBC_HAVE_$name
+        #error
+        #endif], [AC_DEFINE_UNQUOTED([_GLIBCXX_USE_$name], 1)], [])
+    done
+  elif test "x${with_newlib}" = "xyes"; then
     os_include_dir="os/newlib"
     AC_DEFINE(HAVE_HYPOT)
 
