+    $as_echo "#define HAVE_ALIGNED_ALLOC 1" >>confdefs.h
+
+    $as_echo "#define HAVE_AT_QUICK_EXIT 1" >>confdefs.h
+
+    $as_echo "#define HAVE_QUICK_EXIT 1" >>confdefs.h
+
+    $as_echo "#define HAVE_SYS_TYPES_H 1" >>confdefs.h
