%rename cpp_unique_options rtoskit_cpp_unique_options

*cpp_unique_options:
-nostdinc -isystem %:find-file(../include) -include stdc-predef.h %(rtoskit_cpp_unique_options)

%rename cc1 rtoskit_cc1

*cc1:
%{!std=*:%{!.cc:%{!.cp:%{!.cxx:%{!.cpp:%{!.CPP:%{!.c++:%{!.C:%{!.ii:%{!xc++*:-std=gnu23}}}}}}}}}} %(rtoskit_cc1)

%rename cc1plus rtoskit_cc1plus

*cc1plus:
-isystem %:find-file(../include/c++/@GCC_VERSION@) -isystem %:find-file(../include/c++/@GCC_VERSION@/arm-none-eabi/%M) -isystem %:find-file(../include/c++/@GCC_VERSION@/backward) %(rtoskit_cc1plus)

%rename link_gcc_c_sequence rtoskit_link_gcc_c_sequence

*link_gcc_c_sequence:
--start-group %{!nolibc:%L} %G --end-group

%rename link rtoskit_link

*link:
%{-speed:-L%:find-file(speed)} --gc-sections %(rtoskit_link)

*lib:
%{-port=*:-lrtos-%*;:-lrtos-none} %{-libc=*:-lc-%*;:-lc}

*startfile:


*endfile:


